# UPI Shield Environment Configuration

# Application Security
SECRET_KEY=upi-shield-secure-secret-key-artha-2026

# Database (Default: SQLite for lightweight local dev; or PostgreSQL: postgresql://user:pass@localhost:5432/upishield)
DATABASE_URL=sqlite:///./upi_shield.db

# Optional Google Gemini API Key for natural language AI explanations
# If left empty, UPI Shield automatically uses its built-in expert deterministic explanation engine.
GEMINI_API_KEY=

# Upload Configuration
MAX_IMAGE_SIZE_MB=5

# Preloaded Demo Account (For Hackathon Judges)
DEMO_USER_EMAIL=demo@upishield.local
DEMO_USER_PASSWORD=DemoShield@2026
